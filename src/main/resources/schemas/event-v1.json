{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "EventMessage_v1",
  "type": "object",
  "required": ["version", "eventId", "timestamp", "payload"],
  "properties": {
    "version": {
      "type": "string",
      "enum": ["v1"]
    },
    "eventId": {
      "type": "string",
      "pattern": "^evt_[a-zA-Z0-9]+$"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "payload": {
      "type": "object",
      "required": ["userId", "email"],
      "properties": {
        "userId": { "type": "string" },
        "email": { "type": "string", "format": "email" }
      }
    }
  }
}